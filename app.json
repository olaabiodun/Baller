{
  "expo": {
    "name": "baller",
    "slug": "baller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "scheme": "baller",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/images/splscreen.jpg",
      "dark": "./assets/images/splscreen.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#1A1A1B"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1B",
        "foregroundImage": "./assets/images/app_icon.png",
        "backgroundImage": "./assets/images/app_icon.png",
        "monochromeImage": "./assets/images/app_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.abiodun.baller"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app_icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "userInterfaceStyle": "dark",
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "enableBitcode": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splscreen.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1B",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ac13229-c172-4aed-98f9-c10fef756361"
      }
    },
    "owner": "folahanmi1",
    "build": {
      "production": {
        "android": {
          "buildType": "apk"
        },
        "ios": {
          "buildConfiguration": "Release"
        }
      }
    }
  }
}
